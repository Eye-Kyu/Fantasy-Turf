# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/street_football"
# Hosted on Neon: use the pooled connection string (host contains "-pooler") for the app,
# and the direct one (no "-pooler") when running db:migrate or admin:create against it.

# Session cookies are marked Secure in production builds. Set this to false only if
# the production build is served over plain http (e.g. on a home network without TLS).
# SESSION_COOKIE_SECURE=false
