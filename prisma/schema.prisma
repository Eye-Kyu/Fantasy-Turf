// Street Football Fantasy League — database schema.
// Source of truth for table shape; keep the "Core tables" section of CLAUDE.md in sync.
//
// Vocabulary (see CLAUDE.md): "GameDayTeam" is the ephemeral weekly grouping,
// "FantasySquad" is a manager's persistent roster. Never call either just "team".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  MANAGER
  ORGANIZER
  // Only role that may set player traits; also manages users and roles.
  SUPER_ADMIN
}

enum RsvpStatus {
  GOING
  NOT_GOING
  NO_RESPONSE
}

enum EventType {
  GOAL
  ASSIST
  SAVE
  KEY_TACKLE
}

enum AuditAction {
  CREATE
  VOID
  EDIT
  OVERRIDE // organizer change after the gameweek was locked
}

enum LineupSlot {
  STARTER
  BENCH
}

enum BetType {
  TOP_SCORER
  TOP_ASSISTS
  MATCH_WINNER
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
}

// ───────────────────── Identity & players ─────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())

  // Every user is also a player (same person, separate records).
  player Player?

  fantasySquads FantasySquad[]
  bets          Bet[]
  auditLogs     EventAuditLog[]
  liveScored    Match[]         @relation("MatchLiveScorer")
  reconciled    Match[]         @relation("MatchReconciler")
  finesIssued   Fine[]          @relation("FineIssuer")
  finesVoided   Fine[]          @relation("FineVoider")
}

model Player {
  id          String   @id @default(cuid())
  userId      String?  @unique
  displayName String
  pictureUrl  String?
  bio         String?
  // Elo-style rating; drives balancing and fantasy price. Constants are tunable.
  rating        Float    @default(1000)
  price         Decimal  @default(5.0) @db.Decimal(4, 1)
  // Cached on gameweek lock to keep profile pages cheap (see CLAUDE.md).
  currentStreak Int      @default(0)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  traits         PlayerTrait[]
  ratings        PlayerRating[]
  attendances    Attendance[]
  teamMemberships GameDayTeamPlayer[]
  events         MatchEvent[]       @relation("EventPlayer")
  squadMemberships FantasySquadPlayer[]
  lineupEntries  FantasyLineupPlayer[]
  transfersOut   Transfer[]         @relation("TransferOut")
  transfersIn    Transfer[]         @relation("TransferIn")
  betsTargeted   Bet[]
  fines          Fine[]
}

// Descriptive player attributes (scorer, talisman, ...). Set only by SUPER_ADMIN
// (enforced at the API boundary). Not used to sort teams for now; see "Deferred" in
// CLAUDE.md.
model Trait {
  id       String @id @default(cuid())
  name     String @unique
  category String

  players PlayerTrait[]
}

model PlayerTrait {
  playerId String
  traitId  String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  trait  Trait  @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@id([playerId, traitId])
}

model PlayerRating {
  id         String   @id @default(cuid())
  playerId   String
  gameweekId String
  rating     Float
  delta      Float
  createdAt  DateTime @default(now())

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameweekId])
}

// ───────────────────── Calendar & attendance ─────────────────────

model Season {
  id       String    @id @default(cuid())
  name     String    @unique
  startsOn DateTime  @db.Date
  endsOn   DateTime? @db.Date

  gameweeks     Gameweek[]
  fantasySquads FantasySquad[]
}

model Gameweek {
  id               String    @id @default(cuid())
  seasonId         String
  number           Int
  // Kick-off of the first match. Game-day teams lock, and RSVPs close, at
  // kickoffAt minus TEAM_LOCK_HOURS_BEFORE_KICKOFF (derived, not stored).
  kickoffAt        DateTime
  // Transfers, captain and bench order lock here.
  lineupDeadline   DateTime
  // Set when reconciliation is confirmed; later edits need an OVERRIDE audit.
  lockedAt         DateTime?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  attendances Attendance[]
  matches     Match[]
  ratings     PlayerRating[]
  lineups     FantasyLineup[]
  transfers   Transfer[]
  bets        Bet[]
  fines       Fine[]

  @@unique([seasonId, number])
}

model Attendance {
  id         String     @id @default(cuid())
  gameweekId String
  playerId   String
  rsvp       RsvpStatus @default(NO_RESPONSE)
  // Confirmed by the organizer on game day; only attended players can score.
  attended   Boolean    @default(false)

  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameweekId, playerId])
}

// ───────────────────── Matches & game-day teams ─────────────────────

model Match {
  id             String    @id @default(cuid())
  gameweekId     String
  number         Int
  // Integrity: neither may be a player in this match (enforced in app code).
  liveScorerId   String?
  reconciledById String?
  reconciledAt   DateTime?

  gameweek   Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  liveScorer User?    @relation("MatchLiveScorer", fields: [liveScorerId], references: [id])
  reconciler User?    @relation("MatchReconciler", fields: [reconciledById], references: [id])

  teams   GameDayTeam[]
  members GameDayTeamPlayer[]
  events  MatchEvent[]
  bets    Bet[]
  fines   Fine[]

  @@unique([gameweekId, number])
}

model GameDayTeam {
  id      String @id @default(cuid())
  matchId String
  name    String

  match   Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members GameDayTeamPlayer[]
  events  MatchEvent[]
  bets    Bet[]

  @@unique([matchId, name])
}

model GameDayTeamPlayer {
  gameDayTeamId String
  playerId      String
  // Denormalized from the team so the DB itself guarantees one team per player
  // per match (see the unique constraint below).
  matchId       String

  gameDayTeam GameDayTeam @relation(fields: [gameDayTeamId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([gameDayTeamId, playerId])
  @@unique([matchId, playerId])
}

model MatchEvent {
  id            String    @id @default(cuid())
  // Generated on the scorer's device so offline retries cannot double-count.
  clientId      String    @unique
  matchId       String
  gameDayTeamId String
  playerId      String
  type          EventType
  // For ASSIST events: the GOAL this assist belongs to.
  relatedEventId String?
  occurredAt    DateTime
  // Voided (never deleted) so the audit trail stays intact.
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())

  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameDayTeam GameDayTeam @relation(fields: [gameDayTeamId], references: [id])
  player      Player      @relation("EventPlayer", fields: [playerId], references: [id])
  relatedEvent MatchEvent?  @relation("GoalAssist", fields: [relatedEventId], references: [id])
  assists      MatchEvent[] @relation("GoalAssist")
  auditLogs    EventAuditLog[]

  @@index([matchId, occurredAt])
}

model EventAuditLog {
  id        String      @id @default(cuid())
  eventId   String
  actorId   String
  action    AuditAction
  before    Json?
  after     Json?
  createdAt DateTime    @default(now())

  event MatchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User       @relation(fields: [actorId], references: [id])

  @@index([eventId])
}

// ───────────────────── Fines (manual deductions) ─────────────────────

// Catalog of fineable violations. Seeded from DEFAULT_VIOLATIONS in
// src/lib/violations.ts and editable afterwards.
model ViolationType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  // Suggested deduction (positive number); an individual Fine may override it.
  defaultPoints Int
  isActive      Boolean @default(true)

  fines Fine[]
}

// A deduction issued manually by an organizer. Voided, never deleted, so the history
// stays intact. Points are deducted from the player's gameweek score even if the
// player did not attend (e.g. a no-show after confirming).
model Fine {
  id              String   @id @default(cuid())
  playerId        String
  gameweekId      String
  // Optional: the match the violation happened in.
  matchId         String?
  violationTypeId String
  // Points deducted (positive). Copied from the catalog at issue time so later
  // catalog edits never rewrite past scores.
  points          Int
  note            String?
  issuedById      String
  createdAt       DateTime @default(now())
  voidedAt        DateTime?
  voidedById      String?

  player        Player        @relation(fields: [playerId], references: [id])
  gameweek      Gameweek      @relation(fields: [gameweekId], references: [id])
  match         Match?        @relation(fields: [matchId], references: [id])
  violationType ViolationType @relation(fields: [violationTypeId], references: [id])
  issuedBy      User          @relation("FineIssuer", fields: [issuedById], references: [id])
  voidedBy      User?         @relation("FineVoider", fields: [voidedById], references: [id])

  @@index([gameweekId, playerId])
}

// ───────────────────── Fantasy ─────────────────────

// A manager's persistent roster for one season.
model FantasySquad {
  id       String @id @default(cuid())
  userId   String
  seasonId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  players   FantasySquadPlayer[]
  lineups   FantasyLineup[]
  transfers Transfer[]

  @@unique([userId, seasonId])
}

// Current roster membership (6 players). Starter/bench/captain live on the
// per-gameweek lineup so past gameweeks keep scoring from the lineup as it stood.
model FantasySquadPlayer {
  squadId  String
  playerId String

  squad  FantasySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id])

  @@id([squadId, playerId])
}

// Snapshot of a squad's selection for one gameweek, frozen at the lineup deadline.
model FantasyLineup {
  id         String @id @default(cuid())
  squadId    String
  gameweekId String
  // Cached when the gameweek locks.
  points     Int?

  squad    FantasySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek Gameweek     @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  players  FantasyLineupPlayer[]

  @@unique([squadId, gameweekId])
}

model FantasyLineupPlayer {
  lineupId   String
  playerId   String
  slot       LineupSlot
  // Auto-sub priority for BENCH slots (1 = first sub); null for starters.
  benchOrder Int?
  isCaptain  Boolean    @default(false)

  lineup FantasyLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player Player        @relation(fields: [playerId], references: [id])

  @@id([lineupId, playerId])
}

model Transfer {
  id          String   @id @default(cuid())
  squadId     String
  gameweekId  String
  playerOutId String
  playerInId  String
  createdAt   DateTime @default(now())

  squad     FantasySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek  Gameweek     @relation(fields: [gameweekId], references: [id])
  playerOut Player       @relation("TransferOut", fields: [playerOutId], references: [id])
  playerIn  Player       @relation("TransferIn", fields: [playerInId], references: [id])

  // Enforces the 1-transfer-per-gameweek limit (TRANSFERS_PER_GAMEWEEK in
  // src/lib/constants.ts). Raising the limit means dropping this constraint.
  @@unique([squadId, gameweekId])
}

// ───────────────────── Betting (built last) ─────────────────────

model Bet {
  id             String    @id @default(cuid())
  userId         String
  gameweekId     String
  type           BetType
  matchId        String?
  targetPlayerId String?
  targetTeamId   String?
  stake          Int
  status         BetStatus @default(OPEN)
  payout         Int?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameweek     Gameweek     @relation(fields: [gameweekId], references: [id])
  match        Match?       @relation(fields: [matchId], references: [id])
  targetPlayer Player?      @relation(fields: [targetPlayerId], references: [id])
  targetTeam   GameDayTeam? @relation(fields: [targetTeamId], references: [id])
}
