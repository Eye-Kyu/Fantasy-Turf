{
  "name": "street-football-fantasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --config vitest.int.config.mts",
    "admin:promote": "tsx --env-file=.env scripts/promote-user.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "neon:migrate": "node scripts/with-neon.mjs drizzle-kit migrate",
    "neon:admin:create": "node scripts/with-neon.mjs tsx scripts/create-admin.ts",
    "neon:start": "node scripts/with-neon.mjs --pooled next start"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
